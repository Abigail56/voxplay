# Copy to .env to override defaults (docker compose reads it automatically).
MATCH_THRESHOLD=0.40
# "Say this phrase" check on /identify. false = accept plain recordings (less safe).
REQUIRE_LIVENESS=true
# Signs voice-game sign-in tokens. Use a long random value (e.g. `openssl rand -hex 32`).
JWT_SECRET=dev-only-secret-change-me
# Player names who can open the admin page (/admin), comma-separated.
ADMIN_USERNAMES=
# Enroll the built-in LibriSpeech readers on startup (solo play needs them).
SEED_SAMPLE_VOICES=true
# Going public (e.g. Tailscale Funnel): where browsers reach the API, and the site's address.
# Then rebuild: docker compose up -d --build
# PUBLIC_API_URL=https://your-pc.your-tailnet.ts.net:8443
# CORS_ORIGINS=https://your-pc.your-tailnet.ts.net,http://localhost:3010
# Host ports, if another app already holds one. With API_PORT, set PUBLIC_API_URL to match and rebuild.
# WEB_PORT=3010
# API_PORT=8010
# DB_PORT=5442
# REDIS_PORT=6389
# Database backups into ./backups: how often, and how many to keep.
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=7
